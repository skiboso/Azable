# Azable backend — Rust/Axum service: Soroban event indexer + wallet auth
# + off-chain data API. Copy this file to .env for local development
# (services/backend/README.md has full setup instructions).

# Postgres connection string. `docker compose up -d postgres` (from the repo
# root) starts a matching local instance.
DATABASE_URL=postgresql://azable:azable@localhost:5432/azable

# Address + port the HTTP server binds to.
BIND_ADDR=0.0.0.0:8080

# Soroban RPC endpoint and network passphrase the indexer and auth challenge
# builder use. Matches the root .env.example's NETWORK/STELLAR_RPC_URL vars.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Comma-separated Soroban contract IDs to index events for. Seed from
# deployments/testnet.json at the repo root.
CONTRACT_IDS=

# Secret used to sign/verify session JWTs. Generate a real random value for
# any non-local environment, e.g.: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_TTL_SECONDS=3600

# How long a /auth/challenge nonce stays valid before /auth/verify rejects it.
AUTH_CHALLENGE_TTL_SECONDS=300

# Indexer polling behavior — same variables/defaults as the old
# scripts/cdc-indexer.ts this service replaces.
POLL_INTERVAL_SECONDS=5
LEDGER_LOOKBACK=1000
MAX_EVENTS_PER_POLL=200
INDEXER_ID=azable-backend

# Rust log filtering (tracing-subscriber EnvFilter syntax), e.g. "debug" or
# "azable_backend=debug,tower_http=debug".
RUST_LOG=info
